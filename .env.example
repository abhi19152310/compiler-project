# Copy this file to .env and fill in the values. Never commit .env.

# Which interpreter handles loose English: offline, ollama or gemma.
TEXT2WEB_NLP_BACKEND=gemma

# Gemini API key from https://aistudio.google.com/apikey (used only for gemma).
GEMINI_API_KEY=

# Gemma model on the Gemini API: gemma-4-26b-a4b-it or gemma-4-31b-it.
TEXT2WEB_GEMMA_MODEL=gemma-4-26b-a4b-it

# Ollama model, used only when TEXT2WEB_NLP_BACKEND=ollama (default qwen2.5:3b).
# TEXT2WEB_NLP_MODEL=qwen2.5:3b

TEXT2WEB_NLP_TIMEOUT=30
